{
  "name": "session-mesh",
  "displayName": "Session Mesh",
  "description": "Connect existing Claude Code and Codex sessions through a local MCP messaging bridge.",
  "version": "0.3.4",
  "publisher": "local-lab",
  "engines": {
    "vscode": "^1.94.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onView:sessionMesh.sessions"
  ],
  "scripts": {
    "check": "node --check extension.cjs && node --check native.cjs && node --check ipc.cjs && node --check mcp.cjs && node --check setup.cjs && node --check standards.cjs && node --check bridge-state.cjs && node --check test.cjs",
    "test": "node --test test.cjs",
    "package": "vsce package --target win32-x64 --no-dependencies",
    "release:check": "node scripts/release-check.cjs",
    "package:release": "npm run release:check && vsce package --target win32-x64 --no-dependencies --pre-release"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionMesh",
          "title": "Session Mesh",
          "icon": "mesh.svg"
        }
      ]
    },
    "views": {
      "sessionMesh": [
        {
          "id": "sessionMesh.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "sessionMesh.refresh",
        "title": "Session Mesh: Refresh existing sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "sessionMesh.desktopGuide",
        "title": "Session Mesh: Show desktop and phone workflow",
        "icon": "$(device-mobile)"
      },
      {
        "command": "sessionMesh.confirmDesktop",
        "title": "Session Mesh: Confirm desktop owner"
      },
      {
        "command": "sessionMesh.probe",
        "title": "Session Mesh: Send connection test"
      },
      {
        "command": "sessionMesh.confirmMobile",
        "title": "Session Mesh: Confirm phone receipt"
      },
      {
        "command": "sessionMesh.orchestrator",
        "title": "Session Mesh: Mark as orchestrator",
        "icon": "$(star-full)"
      },
      {
        "command": "sessionMesh.routingMode",
        "title": "Session Mesh: Choose Codex routing mode"
      },
      {
        "command": "sessionMesh.diagnostics",
        "title": "Session Mesh: Show diagnostics and delivery attempts"
      },
      {
        "command": "sessionMesh.setup",
        "title": "Session Mesh: Set up tools and standards",
        "icon": "$(plug)"
      },
      {
        "command": "sessionMesh.remove",
        "title": "Session Mesh: Hide session",
        "icon": "$(trash)"
      },
      {
        "command": "sessionMesh.restore",
        "title": "Session Mesh: Restore hidden sessions"
      },
      {
        "command": "sessionMesh.copyId",
        "title": "Session Mesh: Copy session ID",
        "icon": "$(copy)"
      },
      {
        "command": "sessionMesh.open",
        "title": "Session Mesh: Open session details"
      },
      {
        "command": "sessionMesh.send",
        "title": "Session Mesh: Send message to existing session"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sessionMesh.desktopGuide",
          "when": "view == sessionMesh.sessions",
          "group": "navigation"
        },
        {
          "command": "sessionMesh.refresh",
          "when": "view == sessionMesh.sessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sessionMesh.open",
          "when": "view == sessionMesh.sessions",
          "group": "1_connect@0"
        },
        {
          "command": "sessionMesh.send",
          "when": "view == sessionMesh.sessions",
          "group": "1_connect@1"
        },
        {
          "command": "sessionMesh.probe",
          "when": "view == sessionMesh.sessions",
          "group": "1_connect@2"
        },
        {
          "command": "sessionMesh.confirmDesktop",
          "when": "view == sessionMesh.sessions && viewItem == codexSession",
          "group": "1_connect@3"
        },
        {
          "command": "sessionMesh.confirmMobile",
          "when": "view == sessionMesh.sessions",
          "group": "1_connect@4"
        },
        {
          "command": "sessionMesh.orchestrator",
          "when": "view == sessionMesh.sessions",
          "group": "2_manage@5"
        },
        {
          "command": "sessionMesh.copyId",
          "when": "view == sessionMesh.sessions",
          "group": "2_manage@6"
        },
        {
          "command": "sessionMesh.remove",
          "when": "view == sessionMesh.sessions",
          "group": "2_manage@7"
        }
      ]
    },
    "configuration": {
      "title": "Session Mesh",
      "properties": {
        "sessionMesh.nodePath": {
          "type": "string",
          "default": "C:\\Program Files\\nodejs\\node.exe",
          "scope": "machine",
          "restricted": true,
          "description": "Absolute path to Node.js 22+ for shared MCP setup."
        }
      }
    }
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "codex",
    "agents",
    "orchestration",
    "messaging"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Session Mesh connects to local provider sessions and requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "A local Windows filesystem workspace is required."
    }
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  },
  "overrides": {
    "@azure/identity": "4.13.0",
    "uuid": "11.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/clemensgoering/session-mesh.git"
  },
  "homepage": "https://github.com/clemensgoering/session-mesh#readme",
  "bugs": {
    "url": "https://github.com/clemensgoering/session-mesh/issues"
  }
}
